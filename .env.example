NODE_ENV=development
PORT=5005
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sales-pipeline
JWT_SECRET=your-secret-key-min-32-chars-long-generate-with-openssl
JWT_EXPIRE=7d

# CORS (Frontend origin)
CLIENT_URL=http://localhost:5173

# Encryption key for Salesforce tokens at rest (any length - it is hashed
# down to a 32-byte AES-256 key, but use a long random value in production)
ENCRYPTION_KEY=your_32_character_encryption_key_12345678

# Redis (rate limiting + distributed caching). Run `Backend-MERN/tools/redis/redis-server.exe`
# locally with REDIS_HOST/REDIS_PORT below, or in production set REDIS_URL to
# a hosted instance's connection string (e.g. redis://:password@host:port) -
# REDIS_URL takes priority over REDIS_HOST/REDIS_PORT when set, since a
# hosted instance's password has to travel in the URL.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=

# Outbound email (password reset). For Gmail: enable 2-Step Verification on
# the sending account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use it as EMAIL_PASSWORD
# (not the regular account password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Salesforce OAuth (Connected App)
# Callback URL configured in the Connected App must exactly match this value.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_REDIRECT_URI=http://localhost:5005/api/auth/salesforce/callback
SALESFORCE_AUTH_URL=https://login.salesforce.com/services/oauth2/authorize
SALESFORCE_TOKEN_URL=https://login.salesforce.com/services/oauth2/token

# Inbound Salesforce webhook (POST /api/webhooks/salesforce) - shared secret
# used to verify the HMAC-SHA256 signature on the request Salesforce (via a
# Flow/Apex outbound callout, or a bridging middle-tier) sends when an
# Opportunity is closed directly in Salesforce. Generate a long random value
# (e.g. `openssl rand -hex 32`) and configure the same value on the sending
# side.
SALESFORCE_WEBHOOK_SECRET=

# Groq AI assistant (in-app chat widget). Get a free-tier key at
# https://console.groq.com/keys - keep it here, server-side, only. It must
# never be exposed to the frontend/browser bundle or committed to source
# control. Leaving it blank disables the chat widget (it hides itself).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Requests/minute the chat endpoint allows across ALL users combined, since
# Groq's free tier is one shared quota per API key. Tune to your actual plan:
# https://console.groq.com/docs/rate-limits
GROQ_CHAT_RPM_GLOBAL=25
