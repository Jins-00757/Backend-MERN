NODE_ENV=development
PORT=5005
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sales-pipeline
JWT_SECRET=your-secret-key-min-32-chars-long-generate-with-openssl
JWT_EXPIRE=7d

# CORS (Frontend origin)
CLIENT_URL=http://localhost:5173

# Encryption key for Salesforce tokens at rest (any length - it is hashed
# down to a 32-byte AES-256 key, but use a long random value in production)
ENCRYPTION_KEY=your_32_character_encryption_key_12345678

# Redis (rate limiting + distributed caching). Run `Backend-MERN/tools/redis/redis-server.exe`
# locally, or point these at a hosted instance.
REDIS_HOST=localhost
REDIS_PORT=6379

# Salesforce OAuth (Connected App)
# Callback URL configured in the Connected App must exactly match this value.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_REDIRECT_URI=http://localhost:5005/api/auth/salesforce/callback
SALESFORCE_AUTH_URL=https://login.salesforce.com/services/oauth2/authorize
SALESFORCE_TOKEN_URL=https://login.salesforce.com/services/oauth2/token
